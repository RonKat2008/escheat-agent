# Escheat Agent environment. Copy to .env.local and fill in. NEVER commit real secrets.
# Every variable is optional: a missing key shows an honest "not configured" state.

# --- Database ---
# Neon Postgres connection string. Leave unset to use file-backed PGlite at .data/pglite.
DATABASE_URL=
# Separate Neon branch for integration tests (tests default to in-memory PGlite).
DATABASE_URL_TEST=

# --- Models ---
# Powers the classifier, /chat, the Stagehand browser agents and the eval. Unset = labeled heuristic / scripted fallbacks.
ANTHROPIC_API_KEY=
# Edge cases, rule research, report checks and /chat (default claude-opus-5-5; see config/models.ts).
ORCHESTRATOR_MODEL=
# Bulk classification and reply parsing (default claude-haiku-5-5).
WORKER_MODEL=

# --- Inngest (durable workflows). Not needed for the local dev server. ---
# Local dev: leave keys unset (dev mode is automatic outside production). Force with INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Outreach (TEST MODE ONLY) ---
# Lob test key (starts with test_). Live keys must never be used.
LOB_TEST_API_KEY=
LOB_WEBHOOK_SECRET=
# AgentMail (agentmail.to). Run `pnpm agentmail:setup` once: it creates (or finds) the dedicated "escheat-agent" inbox
# and prints the AGENTMAIL_INBOX_ID to paste here. Email is refused ("not configured") until it is set; no other inbox is ever used.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Sender pinning: the local part of AGENTMAIL_INBOX_ID must be "escheat-agent" or email is refused. To send from an inbox
# you own instead, set AGENTMAIL_ALLOWED_INBOX to that inbox's exact address (it must equal AGENTMAIL_INBOX_ID).
AGENTMAIL_ALLOWED_INBOX=
# Svix signing secret (whsec_...) of a webhook pointing at /api/webhooks/agentmail (message.delivered, message.bounced, ...)
AGENTMAIL_WEBHOOK_SECRET=
# Comma-separated. Emails to any other address throw.
ALLOWED_TEST_RECIPIENTS=
# Comma-separated E.164 numbers. Voice calls to any other number throw.
ALLOWED_TEST_PHONES=

# --- Offline mode: 1 = replay LLM/web search from fixtures/cassettes, fake Lob/AgentMail/Vapi locally. /chat answers only from recorded cassettes ---
ESCHEAT_OFFLINE=

# --- QuickBooks Online (optional) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
# Encrypts stored QBO/Plaid tokens at rest. Falls back to OWNER_LINK_SECRET when unset.
QBO_TOKEN_SECRET=
# pnpm smoke:live only: a sandbox refresh token and realm id from the Intuit OAuth Playground (QBO has no client-credentials flow).
# The refresh token rotates on use, so update it after each run.
QBO_SMOKE_REFRESH_TOKEN=
QBO_SMOKE_REALM_ID=

# --- Plaid (optional, sandbox only) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Vapi voice (optional) ---
# Private API key (dashboard > API Keys), not the public key.
VAPI_API_KEY=
# Vapi phone number to call from (a Twilio/Vapi number imported in the dashboard).
VAPI_PHONE_NUMBER_ID=
# Optional. Unset = the app sends an inline, tool-free assistant built from the approved script.
# If set, the assistant is read before every call and the call is refused if it has transfer tools, a forwarding
# number, or any toolIds.
VAPI_ASSISTANT_ID=

# --- App ---
# Public origin of this deployment: CSRF origin check, agent/replica URLs, smoke:live target.
APP_BASE_URL=http://localhost:3000
# Canonical origin for marketing-site metadata (/, /how-it-works, /security): metadataBase for the title and Open Graph tags. Public, so never put a secret here.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Passcode gate for the app (everything except the marketing pages, owner links and signed webhooks). Required in production.
APP_PASSCODE=
# HMAC secret for signed owner-response links.
OWNER_LINK_SECRET=
# Bearer token for the MCP HTTP endpoint.
MCP_TOKEN=

# --- Business settings ---
# "Stale" is a business threshold (days outstanding), separate from legal presumed-abandoned dates.
STALE_THRESHOLD_DAYS=180
# Demo "today" (YYYY-MM-DD) so the seeded numbers are stable.
DEMO_ANCHOR_DATE=2026-11-01
# 1/true forces demo mode (clock = DEMO_ANCHOR_DATE + simulated offset); 0/false forces real dates.
# Default: on whenever DEMO_ANCHOR_DATE is set.
DEMO_MODE=

# --- Optional browser hosting for the filing agent (default is local Playwright) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Browser agents (filing / recovery against /replica/* only) ---
# Production/Vercel refuses the agent routes unless this is 1 (needs a host that can run Chromium).
AGENTS_ENABLED=
# Stagehand model id (default anthropic/claude-sonnet-5-5). Without ANTHROPIC_API_KEY the labeled scripted driver runs.
# pnpm smoke:live fails the Stagehand row unless the model actually made at least one call.
STAGEHAND_MODEL=
# 1 shows the agent browser window instead of running headless.
AGENT_HEADED=
# Signs the replica portal session cookie (a fixed dev fallback is used when unset).
REPLICA_SESSION_SECRET=

# --- Local development / tooling ---
# Local PGlite data directory (default .data/pglite). PGlite is single-process: give each concurrent server its own.
PGLITE_DATA_DIR=
# Next.js build directory (default .next) so concurrent servers/builds do not collide.
NEXT_DIST_DIR=
# 1 forces the Inngest dev-mode client outside NODE_ENV=development.
INNGEST_DEV=
# 1 records live LLM calls as cassettes under fixtures/cassettes (needs ANTHROPIC_API_KEY).
ESCHEAT_RECORD=
# Eval overrides: cases directory (default fixtures/eval) and the holder's state of incorporation (default DE).
EVAL_CASES_DIR=
EVAL_HOLDER_STATE=
# Playwright: E2E_PORT is the base port of the three isolated e2e servers (default 3320; they use +1, +2, +3).
E2E_PORT=
# Playwright: E2E_BASE_URL is read by scripts/agent-e2e.sh (target of an already-running server).
E2E_BASE_URL=
# Playwright: suffix for the e2e data/build dirs so two runs can go at once (also set E2E_PORT).
E2E_DIR_SUFFIX=
# Playwright: set to a directory to also capture visual-QA screenshots at 375/1024/1440.
E2E_SHOTS_DIR=
# The e2e servers (scripts/e2e-server.ts) blank every live key (Anthropic, Lob, AgentMail, Vapi, QuickBooks, Plaid,
# DATABASE_URL), so local e2e never uses your .env.local keys and always shows "not configured" states.
# Standard Node/Next/CI variables also read: PORT (default 3000), NODE_ENV, VERCEL, CI.

# --- Security hardening (see docs/SECURITY-REVIEW.md remediation) ---
# Production/Vercel REFUSES to serve the app (503 "Set APP_PASSCODE") unless APP_PASSCODE is set. Use 12+ characters.
# Optional extra key material for the signed session cookie. Rotating it signs everyone out.
SESSION_SECRET=
# Bump (any new value) to revoke every existing session without changing the passcode.
SESSION_EPOCH=
# How long an in-app approval stays usable before it expires (hours, default 24).
APPROVAL_TTL_HOURS=
# MCP_TOKEN is required in every environment. Extra comma-separated Host values the MCP endpoint accepts
# (APP_BASE_URL, VERCEL_URL and, outside production, localhost are always accepted).
MCP_ALLOWED_HOSTS=
# DEMO_MODE=1 is REQUIRED in production for the demo clock (POST /api/clock); AGENTS_ENABLED=1 for the browser agents.
# INNGEST_DEV is ignored in production.

# Escheat Agent environment template.
#
# `pnpm run setup` copies this to .env.local (only if it does not exist yet) and fills the two local
# secrets below with random values. NEVER commit .env.local or real secrets.
#
# Convention: a line that starts with "# NAME=" is OPTIONAL and OFF. Remove the "# " and add a value to turn it on.
# (Blank "NAME=" lines are avoided on purpose: an empty value can override a built-in default.)
# `pnpm run doctor` shows which optional groups are on, by variable name only.

# =====================================================================================================
# 1. REQUIRED FOR THE DEMO: nothing. Zero keys. The whole demo runs offline on synthetic data.
#    The three lines in this section are local-only and already safe; setup fills the two secrets for you.
# =====================================================================================================
# HMAC secret for signed owner-response links (16+ chars). Generated by `pnpm run setup` when empty.
OWNER_LINK_SECRET=
# Bearer token for the MCP HTTP endpoint. Generated by `pnpm run setup` when empty.
MCP_TOKEN=
# Public origin of this app: CSRF origin check, agent/replica URLs.
APP_BASE_URL=http://localhost:3000
# Demo "today" so the seeded numbers are stable (47 items / $61,915.00).
DEMO_ANCHOR_DATE=2026-11-01
# "Stale" is a business threshold (days outstanding), separate from legal presumed-abandoned dates.
STALE_THRESHOLD_DAYS=180

# =====================================================================================================
# 2. OPTIONAL: AI (without a key: labeled heuristic classifier, scripted browser agents, no live /chat)
# =====================================================================================================
# Powers the classifier, /chat, the Stagehand browser agents and the eval.
# ANTHROPIC_API_KEY=
# Edge cases, rule research, report checks and /chat (default claude-opus-5-5; see config/models.ts).
# ORCHESTRATOR_MODEL=
# Bulk classification and reply parsing (default claude-haiku-5-5).
# WORKER_MODEL=
# Stagehand model id (default anthropic/claude-sonnet-5-5). Without ANTHROPIC_API_KEY the scripted driver runs.
# STAGEHAND_MODEL=
# 1 = replay recorded LLM/web-search calls from fixtures/cassettes, fake Lob/AgentMail/Vapi locally.
# /chat then answers only the recorded demo prompts.
# ESCHEAT_OFFLINE=1

# =====================================================================================================
# 3. OPTIONAL: SENDS (TEST MODE ONLY; every send also needs an in-app human approval)
# =====================================================================================================
# --- Letters: Lob TEST key (starts with test_). Live keys are refused. ---
# LOB_TEST_API_KEY=
# LOB_WEBHOOK_SECRET=
# --- Email: AgentMail. Run `pnpm agentmail:setup` once: it creates (or finds) the dedicated "escheat-agent"
# inbox and prints the AGENTMAIL_INBOX_ID to paste here. Email is refused until it is set. ---
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# The local part of AGENTMAIL_INBOX_ID must be "escheat-agent". To send from an inbox you own instead, set this
# to that inbox's exact address (it must equal AGENTMAIL_INBOX_ID).
# AGENTMAIL_ALLOWED_INBOX=
# Svix signing secret (whsec_...) of a webhook pointing at /api/webhooks/agentmail.
# AGENTMAIL_WEBHOOK_SECRET=
# --- Allowlists: sends to anyone else throw. ---
# Comma-separated email addresses you control.
# ALLOWED_TEST_RECIPIENTS=
# Comma-separated E.164 phone numbers you control.
# ALLOWED_TEST_PHONES=
# --- Voice: Vapi (private API key, not the public key). ---
# VAPI_API_KEY=
# Vapi phone number to call from (a Twilio/Vapi number imported in the dashboard).
# VAPI_PHONE_NUMBER_ID=
# Unset = inline, tool-free assistant built from the approved script. If set, the call is refused when the
# assistant has transfer tools, a forwarding number, or any toolIds.
# VAPI_ASSISTANT_ID=

# =====================================================================================================
# 4. OPTIONAL: INTEGRATIONS
# =====================================================================================================
# --- Database: Neon Postgres. Unset = file-backed PGlite at .data/pglite. ---
# DATABASE_URL=
# Separate Neon branch for integration tests (tests default to in-memory PGlite).
# DATABASE_URL_TEST=
# --- Inngest (durable workflows). Not needed locally; dev mode is automatic outside production. ---
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# 1 forces the Inngest dev-mode client outside NODE_ENV=development (ignored in production).
# INNGEST_DEV=
# --- QuickBooks Online (sandbox) ---
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=
# Encrypts stored QBO/Plaid tokens at rest. Falls back to OWNER_LINK_SECRET when unset.
# QBO_TOKEN_SECRET=
# pnpm smoke:live only: a sandbox refresh token and realm id from the Intuit OAuth Playground. The token rotates on use.
# QBO_SMOKE_REFRESH_TOKEN=
# QBO_SMOKE_REALM_ID=
# --- Plaid (sandbox only) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# --- Browser agents (filing / recovery against /replica/* only) ---
# Optional hosted browser (default is local Playwright).
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# Production/Vercel refuses the agent routes unless this is 1 (needs a host that can run Chromium).
# AGENTS_ENABLED=
# 1 shows the agent browser window instead of running headless.
# AGENT_HEADED=
# Signs the replica portal session cookie (a fixed dev fallback is used when unset).
# REPLICA_SESSION_SECRET=

# =====================================================================================================
# 5. OPTIONAL: APP, DEPLOYMENT AND SECURITY (defaults are fine locally)
# =====================================================================================================
# Passcode gate for the app (everything except the marketing pages, owner links and signed webhooks).
# REQUIRED in production (the app answers 503 until set; use 12+ characters). Unset in dev = no login screen.
# APP_PASSCODE=
# Canonical origin for marketing-site metadata (metadataBase, Open Graph). Public: never put a secret here.
# NEXT_PUBLIC_SITE_URL=
# Optional extra key material for the signed session cookie. Rotating it signs everyone out.
# SESSION_SECRET=
# Bump (any new value) to revoke every existing session without changing the passcode.
# SESSION_EPOCH=
# How long an in-app approval stays usable before it expires (hours, default 24).
# APPROVAL_TTL_HOURS=
# Extra comma-separated Host values the MCP endpoint accepts (APP_BASE_URL, VERCEL_URL and, outside production,
# localhost are always accepted).
# MCP_ALLOWED_HOSTS=
# 1/true forces demo mode (clock = DEMO_ANCHOR_DATE + simulated offset); 0/false forces real dates.
# Default: on whenever DEMO_ANCHOR_DATE is set. DEMO_MODE=1 is REQUIRED in production for the demo clock.
# DEMO_MODE=

# =====================================================================================================
# 6. DEVELOPMENT AND TOOLING (you can ignore these)
# =====================================================================================================
# Local PGlite data directory (default .data/pglite). PGlite is single-process: one directory per concurrent server.
# PGLITE_DATA_DIR=
# Next.js build directory (default .next) so concurrent servers/builds do not collide.
# NEXT_DIST_DIR=
# 1 records live LLM calls as cassettes under fixtures/cassettes (needs ANTHROPIC_API_KEY).
# ESCHEAT_RECORD=
# Eval overrides: cases directory (default fixtures/eval) and the holder's state of incorporation (default DE).
# EVAL_CASES_DIR=
# EVAL_HOLDER_STATE=
# Playwright: E2E_PORT is the base port of the three isolated e2e servers (default 3320; they use +1, +2, +3).
# E2E_PORT=
# Playwright: target of an already-running server (scripts/agent-e2e.sh).
# E2E_BASE_URL=
# Playwright: suffix for the e2e data/build dirs so two runs can go at once (also set E2E_PORT).
# E2E_DIR_SUFFIX=
# Playwright: a directory to also capture visual-QA screenshots at 375/1024/1440.
# E2E_SHOTS_DIR=
# The e2e servers (scripts/e2e-server.ts) blank every live key, so local e2e never uses your .env.local keys.
# Standard Node/Next/CI variables also read: PORT (default 3000), NODE_ENV, VERCEL, CI.
